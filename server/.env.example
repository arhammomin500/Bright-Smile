# Copy to .env and fill in. DATABASE_URL is a PostgreSQL connection string —
# for free hosting use Neon (https://neon.tech), e.g.:
# postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=change-me-64-random-chars
JWT_REFRESH_SECRET=change-me-64-random-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Optional SMTP (emails are logged to the console when unset)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="Bright Smile Dental Clinic <noreply@brightsmile.example>"

CLINIC_NAME="Bright Smile Dental Clinic"
CLINIC_PHONE="+91 93732 23464"
CLINIC_WHATSAPP="919373223464"
